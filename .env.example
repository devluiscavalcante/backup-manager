# Copie para .env e ajuste. O arquivo .env e carregado automaticamente e nao vai para o Git.

# --- Banco de dados (lidos tambem pelo docker-compose.yml) ---
DB_HOST=localhost
# Troque (ex.: 55432) se um PostgreSQL nativo ja usar a 5432.
DB_PORT=5432
DB_NAME=backup_manager
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Aplicacao ---
APP_PORT=8080
# APP_VERSION=
# Menor intervalo entre execucoes de um agendamento (crons mais frequentes sao recusados):
# BACKUP_SCHEDULER_MIN_INTERVAL=5m
# Prazo para backups/restauracoes em andamento terminarem no encerramento (no Docker, use stop_grace_period maior):
# APP_SHUTDOWN_TIMEOUT=30s

# --- Acesso ---
APP_SECURITY_USERNAME=admin
# Obrigatoria: vazia, a aplicacao nao sobe. Defina uma senha propria.
APP_SECURITY_PASSWORD=
# APP_SECURITY_ROLE=ADMIN
APP_SECURITY_OPERATOR_ENABLED=false
# APP_SECURITY_OPERATOR_USERNAME=operator
# APP_SECURITY_OPERATOR_PASSWORD=
# APP_SECURITY_OPERATOR_ROLE=OPERATOR
# Somente para desenvolvimento local:
# APP_SECURITY_ALLOW_DEFAULT_PASSWORD=false

# Raizes onde backups e restauracoes podem ler/escrever (separadas por virgula).
# Use / ou \\ no Windows: o .env e lido como .properties e uma \ sozinha vira escape.
APP_SECURITY_ALLOWED_PATH_ROOTS=C:/Dados,C:/Backups
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:4200
# Bloqueio temporario por IP apos credenciais recusadas:
# APP_SECURITY_MAX_FAILED_LOGINS=10
# APP_SECURITY_FAILED_LOGIN_LOCKOUT=5m

# --- Auditoria ---
# AUDIT_RETENTION_ENABLED=true
# AUDIT_RETENTION_MAX_DAYS=90

# --- Notificacoes por e-mail ---
NOTIFICATION_ENABLED=false
# NOTIFICATION_EMAIL_FROM=noreply@example.com
# NOTIFICATION_EMAIL_RECIPIENTS=ops@example.com,admin@example.com
# NOTIFICATION_NOTIFY_SUCCESS=false
# NOTIFICATION_NOTIFY_FAILURE=true
# NOTIFICATION_NOTIFY_CANCELLATION=true
# Desligados por padrao; ate a versao anterior vinham sempre ligados:
# NOTIFICATION_NOTIFY_STARTED=false
# NOTIFICATION_NOTIFY_SCHEDULED=false
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# SSL direto (465). Para STARTTLS (587): MAIL_SSL_ENABLED=false e MAIL_STARTTLS_ENABLED=true
# MAIL_SSL_ENABLED=true
# MAIL_STARTTLS_ENABLED=false
